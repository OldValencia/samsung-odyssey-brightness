#include <windows.h>

#include "resource.h"
#include "version.h"

IDI_APP_ICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Samsung Brightness"
            VALUE "FileVersion", APP_VERSION_TEXT
            VALUE "OriginalFilename", "SamsungBrightness.exe"
            VALUE "ProductName", "Samsung Brightness"
            VALUE "ProductVersion", APP_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
