#include <windows.h>
#include <commctrl.h>

#include "resource.h"
#include "version.h"

IDI_APP_ICON ICON "app.ico"

IDD_SHORTCUT DIALOGEX 0, 0, 231, 107
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keyboard shortcut"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Press up to five keys together.", -1, 12, 12, 207, 10
    EDITTEXT IDC_SHORTCUT_KEY, 12, 28, 207, 17, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Release the keys, then click Save.", -1, 12, 54, 207, 12
    PUSHBUTTON "Clear", IDC_SHORTCUT_CLEAR, 12, 82, 51, 14
    DEFPUSHBUTTON "Save", IDOK, 111, 82, 51, 14
    PUSHBUTTON "Cancel", IDCANCEL, 168, 82, 51, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 376, 317
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Samsung Brightness Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_SETTINGS_TABS, WC_TABCONTROL, WS_TABSTOP | WS_CLIPSIBLINGS, 8, 8, 360, 281
    PUSHBUTTON "Close", IDCANCEL, 311, 295, 55, 15
END

IDD_SETTINGS_MONITOR DIALOGEX 0, 0, 352, 264
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Monitor connection", -1, 8, 5, 336, 93
    LTEXT "Monitor &address", -1, 18, 21, 75, 10
    EDITTEXT IDC_SETTINGS_HOST, 98, 18, 234, 14, ES_AUTOHSCROLL
    LTEXT "Local IP address or hostname, e.g. 192.168.1.50", -1, 98, 35, 234, 10
    LTEXT "&Port", -1, 18, 51, 75, 10
    EDITTEXT IDC_SETTINGS_PORT, 98, 48, 53, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Samsung IP Remote defaults to 1516", -1, 161, 51, 171, 10
    LTEXT "Access &token", -1, 18, 71, 75, 10
    EDITTEXT IDC_SETTINGS_TOKEN, 98, 68, 234, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Leave blank to pair with the monitor.", -1, 98, 84, 234, 10

    GROUPBOX "Brightness settings", -1, 8, 105, 336, 68
    LTEXT "&Maximum", -1, 18, 121, 75, 10
    EDITTEXT IDC_SETTINGS_MAX, 98, 118, 53, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "50 on Odyssey OLED G8", -1, 161, 121, 171, 10
    LTEXT "&Step", -1, 18, 139, 75, 10
    EDITTEXT IDC_SETTINGS_STEP, 98, 136, 53, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Smaller values give more steps.", -1, 161, 139, 171, 10
    AUTOCHECKBOX "Use a brightness cur&ve", IDC_SETTINGS_CURVE, 18, 155, 140, 12
    AUTOCHECKBOX "S&mooth transitions", IDC_SETTINGS_TRANSITIONS, 161, 155, 161, 12

    LTEXT "Brightness: checking...", IDC_SETTINGS_LEVEL, 10, 180, 323, 11
    COMBOBOX IDC_SETTINGS_PRESETS, 10, 193, 51, 98, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Set brightness", IDC_SETTINGS_SET_LEVEL, 68, 193, 82, 15
    PUSHBUTTON "Refresh", IDC_SETTINGS_REFRESH, 156, 193, 64, 15
    PUSHBUTTON "Pair with monitor...", IDC_SETTINGS_PAIR, 226, 193, 107, 15
    AUTOCHECKBOX "Write &debug log", IDC_SETTINGS_LOG, 10, 217, 119, 12
    PUSHBUTTON "Edit .env...", IDC_SETTINGS_EDIT_ENV, 137, 215, 81, 15
    PUSHBUTTON "Reload .env", IDC_SETTINGS_RELOAD, 224, 215, 109, 15
    LTEXT "Save applies changes immediately.", IDC_SETTINGS_STATUS, 10, 236, 249, 23
    DEFPUSHBUTTON "Save", IDOK, 266, 236, 67, 16
END

IDD_SETTINGS_APPEARANCE DIALOGEX 0, 0, 352, 264
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    LTEXT "On-screen display &theme", -1, 14, 15, 168, 11
    LISTBOX IDC_SETTINGS_THEME, 14, 32, 170, 115, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_TABSTOP | WS_VSCROLL
    LTEXT "", IDC_SETTINGS_THEME_DESCRIPTION, 200, 36, 134, 52
    PUSHBUTTON "Preview", IDC_SETTINGS_PREVIEW, 200, 98, 80, 17
    GROUPBOX "OSD size", -1, 14, 159, 324, 85
    RTEXT "100%", IDC_OSD_SIZE_VALUE, 276, 172, 49, 12
    CONTROL "", IDC_OSD_SIZE_SLIDER, TRACKBAR_CLASS, WS_TABSTOP | TBS_HORZ | TBS_BOTTOM, 25, 188, 302, 21
    LTEXT "75%", -1, 29, 209, 26, 11
    CTEXT "100%", -1, 113, 209, 28, 11
    CTEXT "125%", -1, 210, 209, 28, 11
    RTEXT "150%", -1, 294, 209, 29, 11
    LTEXT "Use arrow keys for 1% steps. Changes are saved automatically.", -1, 25, 227, 302, 11
END

IDD_SETTINGS_KEYBOARD DIALOGEX 0, 0, 352, 264
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Global shortcuts", -1, 12, 12, 328, 102
    LTEXT "Increase brightness", -1, 24, 35, 93, 11
    EDITTEXT IDC_SETTINGS_SHORTCUT_UP, 121, 32, 133, 15, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "Record...", IDC_SETTINGS_RECORD_UP, 263, 32, 65, 15
    LTEXT "Decrease brightness", -1, 24, 60, 93, 11
    EDITTEXT IDC_SETTINGS_SHORTCUT_DOWN, 121, 57, 133, 15, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "Record...", IDC_SETTINGS_RECORD_DOWN, 263, 57, 65, 15
    LTEXT "Press up to five keys together when recording a shortcut.", -1, 24, 84, 304, 18
    AUTOCHECKBOX "Use keyboard brightness keys", IDC_SETTINGS_USE_BRIGHTNESS_KEYS, 15, 131, 318, 14
END

IDD_SETTINGS_APPLICATION DIALOGEX 0, 0, 352, 264
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Startup", -1, 12, 12, 328, 72
    AUTOCHECKBOX "Start with Windows", IDC_SETTINGS_AUTOSTART, 24, 34, 298, 13
    LTEXT "Open Samsung Brightness in the tray when you sign in.", -1, 24, 55, 298, 15
END

IDD_SETTINGS_ABOUT DIALOGEX 0, 0, 352, 264
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_SETTINGS_VERSION, 16, 16, 318, 14
    LTEXT "Control the brightness of your Samsung monitor from Windows.", -1, 16, 36, 318, 17
    PUSHBUTTON "GitHub", IDC_SETTINGS_GITHUB, 16, 65, 89, 17
    PUSHBUTTON "Buy Me a Coffee", IDC_SETTINGS_COFFEE, 117, 65, 101, 17
    PUSHBUTTON "Ko-fi", IDC_SETTINGS_KOFI, 230, 65, 82, 17
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Samsung Brightness"
            VALUE "FileVersion", APP_VERSION_TEXT
            VALUE "OriginalFilename", "SamsungBrightness.exe"
            VALUE "ProductName", "Samsung Brightness"
            VALUE "ProductVersion", APP_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
