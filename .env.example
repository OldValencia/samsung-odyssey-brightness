# Samsung Brightness settings. Lines starting with # are comments.
# The app creates this file as ".env" next to SamsungBrightness.exe on the first start.

# IP address of the monitor in your local network.
# Tip: reserve this address for the monitor in your router's DHCP settings.
SAMSUNG_MONITOR_IP=192.168.1.231

# Access token of the monitor. Use "Pair with monitor..." in the tray menu to fill it in.
# Keep this file private: the token allows controlling the monitor.
SAMSUNG_ACCESS_TOKEN=

# Port of the Samsung IP Control server.
SAMSUNG_MONITOR_PORT=1516

# How much one key press changes the brightness.
BRIGHTNESS_STEP=5

# The highest brightness value the monitor accepts (50 on the Odyssey OLED G8).
BRIGHTNESS_MAX=50

# Set to 1 to write samsung-brightness.log next to the exe.
DEBUG_LOG=0
